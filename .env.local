# =========================
# Core App
# =========================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=AstralForge
NEXT_PUBLIC_APP_DOMAIN=astralforge.studio

# =========================
# URLs / Subdomains
# =========================
NEXT_PUBLIC_MAIN_URL=http://localhost:3000
NEXT_PUBLIC_ACCOUNTS_URL=http://accounts.localhost:3000
NEXT_PUBLIC_PLAY_URL=http://play.localhost:3000
NEXT_PUBLIC_SHOP_URL=http://shop.localhost:3000
NEXT_PUBLIC_CODEX_URL=http://codex.localhost:3000

# =========================
# Auth (Forge-Pass placeholder)
# =========================
AUTH_SECRET=your-super-secret-key
NEXT_PUBLIC_AUTH_URL=http://accounts.localhost:3000

# =========================
# API
# =========================
NEXT_PUBLIC_API_URL=http://localhost:8787
API_INTERNAL_URL=http://localhost:8787

# =========================
# Cloudflare (Wrangler)
# =========================
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token

# =========================
# Database (future - D1)
# =========================
DATABASE_URL=

# =========================
# Storage (future - R2)
# =========================
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# =========================
# Payments (Stripe - future)
# =========================
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# =========================
# Email (Mailgun - future)
# =========================
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# =========================
# Analytics (optional)
# =========================
NEXT_PUBLIC_ANALYTICS_ID=